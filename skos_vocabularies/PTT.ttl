@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# namespace
@prefix ptt: <https://github.com/mod-bib/biblio-gad/skos_vocabularies/PTT.ttl> .

# concept scheme that represents the thesaurus
ptt:PublicationTypeThesaurus a skos:ConceptScheme .
ptt:PublicationTypeThesaurus skos:prefLabel "Publication Type Thesaurus"@en .

# concept 1
ptt:LibriRaccolte a skos:Concept .
# for each concept you need to say it is part of the thesaurus
ptt:LibriRaccolte skos:inScheme ptt:PublicationTypeThesaurus .
# preferred label
ptt:LibriRaccolte skos:prefLabel "Libri e raccolte d'autore"@it .

