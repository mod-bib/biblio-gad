@prefix : <https://raw.githubusercontent.com/mod-bib/biblio-gad/refs/heads/main/ontology/sample.ttl#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix gbo: <https://github.com/mod-bib/biblio-gad/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo: <http://purl.org/ontology/bibo/1.3/> .
@prefix rdai: <http://rdaregistry.info/Elements/i/> .
@prefix rdam: <http://rdaregistry.info/Elements/m/> .
@prefix rdau: <http://rdaregistry.info/Elements/u/> .
@prefix rdaw: <http://rdaregistry.info/Elements/w/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix schema1: <http://schema.org/> .
@base <https://raw.githubusercontent.com/mod-bib/biblio-gad/refs/heads/main/ontology/sample.ttl> .

<https://raw.githubusercontent.com/mod-bib/biblio-gad/refs/heads/main/ontology/sample.ttl> rdf:type owl:Ontology .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYearMonth
xsd:gYearMonth rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://iflastandards.info/ns/lrm/lrmoo/R2_is_derivative_of
lrmoo:R2_is_derivative_of rdf:type owl:ObjectProperty ;
                          rdfs:domain lrmoo:F1_Work ;
                          rdfs:range lrmoo:F1_Work .


###  http://iflastandards.info/ns/lrm/lrmoo/R3_is_realised_by
lrmoo:R3_is_realised_by rdf:type owl:ObjectProperty ;
                        owl:inverseOf lrmoo:R3i_realises ;
                        rdfs:domain lrmoo:F1_Work ;
                        rdfs:range lrmoo:F2_Expression .


###  http://iflastandards.info/ns/lrm/lrmoo/R3i_realises
lrmoo:R3i_realises rdf:type owl:ObjectProperty ;
                   rdfs:domain lrmoo:F2_Expression ;
                   rdfs:range lrmoo:F1_Work .


###  http://iflastandards.info/ns/lrm/lrmoo/R4_is_embodied_in
lrmoo:R4_is_embodied_in rdf:type owl:ObjectProperty ;
                        owl:inverseOf lrmoo:R4i_embodies ;
                        rdfs:domain lrmoo:F2_Expression ;
                        rdfs:range lrmoo:F3_Manifestation .


###  http://iflastandards.info/ns/lrm/lrmoo/R4i_embodies
lrmoo:R4i_embodies rdf:type owl:ObjectProperty ;
                   rdfs:domain lrmoo:F3_Manifestation ;
                   rdfs:range lrmoo:F2_Expression .


###  http://iflastandards.info/ns/lrm/lrmoo/R5i_is_component_of
lrmoo:R5i_is_component_of rdf:type owl:ObjectProperty ;
                          rdfs:domain lrmoo:F2_Expression ;
                          rdfs:range lrmoo:F2_Expression .


###  http://iflastandards.info/ns/lrm/lrmoo/R71i_is_part_of
lrmoo:R71i_is_part_of rdf:type owl:ObjectProperty ;
                      rdfs:domain lrmoo:F3_Manifestation ;
                      rdfs:range lrmoo:F3_Manifestation .


###  http://iflastandards.info/ns/lrm/lrmoo/R7_exemplifies
lrmoo:R7_exemplifies rdf:type owl:ObjectProperty ;
                     owl:inverseOf lrmoo:R7i_is_exemplified_by ;
                     rdfs:domain lrmoo:F5_Item ;
                     rdfs:range lrmoo:F3_Manifestation .


###  http://iflastandards.info/ns/lrm/lrmoo/R7i_is_exemplified_by
lrmoo:R7i_is_exemplified_by rdf:type owl:ObjectProperty ;
                            rdfs:domain lrmoo:F3_Manifestation ;
                            rdfs:range lrmoo:F5_Item .


###  http://rdaregistry.info/Elements/i/P40069_has_related_work_of_item
rdai:P40069_has_related_work_of_item rdf:type owl:ObjectProperty ;
                                     owl:inverseOf rdaw:P10310_has_related_item_of_work ;
                                     rdfs:domain lrmoo:F5_Item ;
                                     rdfs:range lrmoo:F1_Work .


###  http://rdaregistry.info/Elements/m/P30088_has_place_of_publication
rdam:P30088_has_place_of_publication rdf:type owl:ObjectProperty ;
                                     rdfs:domain [ rdf:type owl:Class ;
                                                   owl:unionOf ( bibo:Periodical
                                                                 gbo:Publication
                                                               )
                                                 ] ;
                                     rdfs:range schema1:Place .


###  http://rdaregistry.info/Elements/m/P30135_has_work_manifested
rdam:P30135_has_work_manifested rdf:type owl:ObjectProperty ;
                                owl:inverseOf rdaw:P10072_has_manifestation_of_work ;
                                rdfs:domain lrmoo:F3_Manifestation ;
                                rdfs:range lrmoo:F1_Work .


###  http://rdaregistry.info/Elements/u/P60306_is_continued_by
rdau:P60306_is_continued_by rdf:type owl:ObjectProperty ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( bibo:Periodical
                                                        gbo:Publication
                                                        gbo:PublicationComponent
                                                      )
                                        ] ;
                            rdfs:range [ rdf:type owl:Class ;
                                         owl:unionOf ( bibo:Periodical
                                                       gbo:Publication
                                                       gbo:PublicationComponent
                                                     )
                                       ] .


###  http://rdaregistry.info/Elements/w/P10072_has_manifestation_of_work
rdaw:P10072_has_manifestation_of_work rdf:type owl:ObjectProperty ;
                                      rdfs:domain lrmoo:F1_Work ;
                                      rdfs:range lrmoo:F3_Manifestation .


###  http://rdaregistry.info/Elements/w/P10310_has_related_item_of_work
rdaw:P10310_has_related_item_of_work rdf:type owl:ObjectProperty ;
                                     rdfs:domain lrmoo:F1_Work ;
                                     rdfs:range lrmoo:F5_Item .


###  http://schema.org/author
schema1:author rdf:type owl:ObjectProperty ;
               rdfs:domain lrmoo:F1_Work ;
               rdfs:range schema1:Person .


###  http://schema.org/birthPlace
schema1:birthPlace rdf:type owl:ObjectProperty ;
                   rdfs:domain schema1:Person ;
                   rdfs:range schema1:Place .


###  http://schema.org/contributor
schema1:contributor rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( gbo:Publication
                                                gbo:PublicationComponent
                                              )
                                ] ;
                    rdfs:range schema1:Person .


###  http://schema.org/deathPlace
schema1:deathPlace rdf:type owl:ObjectProperty ;
                   rdfs:domain schema1:Person ;
                   rdfs:range schema1:Place .


###  http://www.cidoc-crm.org/cidoc-crm/P50_has_current_keeper
crm:P50_has_current_keeper rdf:type owl:ObjectProperty ;
                           rdfs:domain lrmoo:F5_Item ;
                           rdfs:range crm:E39_Actor .


###  https://github.com/mod-bib/biblio-gad/ontology/carries
gbo:carries rdf:type owl:ObjectProperty ;
            owl:inverseOf gbo:isCarriedBy ;
            rdfs:domain gbo:PublicationComponent ;
            rdfs:range lrmoo:F2_Expression .


###  https://github.com/mod-bib/biblio-gad/ontology/hasPeriodical
gbo:hasPeriodical rdf:type owl:ObjectProperty ;
                  owl:inverseOf gbo:hasPeriodicalIssue ;
                  rdfs:domain gbo:PeriodicalIssue ;
                  rdfs:range bibo:Periodical .


###  https://github.com/mod-bib/biblio-gad/ontology/hasPeriodicalIssue
gbo:hasPeriodicalIssue rdf:type owl:ObjectProperty ;
                       rdfs:domain bibo:Periodical ;
                       rdfs:range gbo:PeriodicalIssue .


###  https://github.com/mod-bib/biblio-gad/ontology/hasSourceWork
gbo:hasSourceWork rdf:type owl:ObjectProperty ;
                  rdfs:domain lrmoo:F1_Work ;
                  rdfs:range lrmoo:F1_Work .


###  https://github.com/mod-bib/biblio-gad/ontology/isCarriedBy
gbo:isCarriedBy rdf:type owl:ObjectProperty ;
                rdfs:domain lrmoo:F2_Expression ;
                rdfs:range gbo:PublicationComponent .


###  https://github.com/mod-bib/biblio-gad/ontology/isIncludedInPeriodicalIssue
gbo:isIncludedInPeriodicalIssue rdf:type owl:ObjectProperty ;
                                rdfs:domain gbo:PublicationComponent ;
                                rdfs:range gbo:PeriodicalIssue .


###  https://github.com/mod-bib/biblio-gad/ontology/isIncludedInVolume
gbo:isIncludedInVolume rdf:type owl:ObjectProperty ;
                       rdfs:domain gbo:PublicationComponent ;
                       rdfs:range gbo:Publication .


###  https://github.com/mod-bib/biblio-gad/ontology/isRepresentedBy
gbo:isRepresentedBy rdf:type owl:ObjectProperty ;
                    rdfs:domain gbo:PublicationComponent ;
                    rdfs:range lrmoo:F5_Item .


###  https://github.com/mod-bib/biblio-gad/ontology/publisher
gbo:publisher rdf:type owl:ObjectProperty ;
              rdfs:domain gbo:Publication ;
              rdfs:range gbo:PublishingHouse .


###  https://github.com/mod-bib/biblio-gad/ontology/represents
gbo:represents rdf:type owl:ObjectProperty ;
               rdfs:domain lrmoo:F5_Item ;
               rdfs:range gbo:PublicationComponent .


#################################################################
#    Data properties
#################################################################

###  http://rdaregistry.info/Elements/m/P30011_has_date_of_publication
rdam:P30011_has_date_of_publication rdf:type owl:DatatypeProperty ;
                                    rdfs:domain [ rdf:type owl:Class ;
                                                  owl:unionOf ( gbo:Publication
                                                                gbo:PublicationComponent
                                                              )
                                                ] ;
                                    rdfs:range rdfs:Literal .


###  http://rdaregistry.info/Elements/m/P30106_has_series_statement
rdam:P30106_has_series_statement rdf:type owl:DatatypeProperty ;
                                 rdfs:domain gbo:Publication .


###  http://schema.org/birthDate
schema1:birthDate rdf:type owl:DatatypeProperty ;
                  rdfs:domain schema1:Person .


###  http://schema.org/deathDate
schema1:deathDate rdf:type owl:DatatypeProperty ;
                  rdfs:domain schema1:Person .


###  http://schema.org/genre
schema1:genre rdf:type owl:DatatypeProperty ;
              rdfs:domain lrmoo:F1_Work .


###  http://schema.org/pagination
schema1:pagination rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( gbo:Publication
                                               gbo:PublicationComponent
                                             )
                               ] .


###  https://github.com/mod-bib/biblio-gad/ontology/hasCompositionDateFrom
gbo:hasCompositionDateFrom rdf:type owl:DatatypeProperty ;
                           rdfs:domain lrmoo:F2_Expression ;
                           rdfs:range rdfs:Literal .


###  https://github.com/mod-bib/biblio-gad/ontology/hasCompositionDateTo
gbo:hasCompositionDateTo rdf:type owl:DatatypeProperty ;
                         rdfs:domain lrmoo:F2_Expression ;
                         rdfs:range rdfs:Literal .


###  https://github.com/mod-bib/biblio-gad/ontology/hasIdentifier
gbo:hasIdentifier rdf:type owl:DatatypeProperty .


###  https://github.com/mod-bib/biblio-gad/ontology/hasIssueDetails
gbo:hasIssueDetails rdf:type owl:DatatypeProperty ;
                    rdfs:domain gbo:PeriodicalIssue ;
                    rdfs:range xsd:string .


###  https://github.com/mod-bib/biblio-gad/ontology/hasName
gbo:hasName rdf:type owl:DatatypeProperty .


###  https://github.com/mod-bib/biblio-gad/ontology/hasNote
gbo:hasNote rdf:type owl:DatatypeProperty .


###  https://github.com/mod-bib/biblio-gad/ontology/hasPosition
gbo:hasPosition rdf:type owl:DatatypeProperty ;
                rdfs:domain lrmoo:F2_Expression .


###  https://github.com/mod-bib/biblio-gad/ontology/hasPseudonym
gbo:hasPseudonym rdf:type owl:DatatypeProperty .


###  https://github.com/mod-bib/biblio-gad/ontology/hasPublicationType
gbo:hasPublicationType rdf:type owl:DatatypeProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( gbo:Publication
                                                   gbo:PublicationComponent
                                                 )
                                   ] .


###  https://github.com/mod-bib/biblio-gad/ontology/hasTitle
gbo:hasTitle rdf:type owl:DatatypeProperty .


###  https://github.com/mod-bib/biblio-gad/ontology/isAnnotated
gbo:isAnnotated rdf:type owl:DatatypeProperty ;
                rdfs:domain lrmoo:F5_Item ;
                rdfs:range xsd:boolean .


###  https://github.com/mod-bib/biblio-gad/ontology/isPartOfSection
gbo:isPartOfSection rdf:type owl:DatatypeProperty ;
                    rdfs:domain gbo:PublicationComponent ;
                    rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://iflastandards.info/ns/lrm/lrmoo/F1_Work
lrmoo:F1_Work rdf:type owl:Class .


###  http://iflastandards.info/ns/lrm/lrmoo/F2_Expression
lrmoo:F2_Expression rdf:type owl:Class .


###  http://iflastandards.info/ns/lrm/lrmoo/F3_Manifestation
lrmoo:F3_Manifestation rdf:type owl:Class .


###  http://iflastandards.info/ns/lrm/lrmoo/F5_Item
lrmoo:F5_Item rdf:type owl:Class .


###  http://purl.org/ontology/bibo/1.3/Periodical
bibo:Periodical rdf:type owl:Class .


###  http://schema.org/Person
schema1:Person rdf:type owl:Class .


###  http://schema.org/Place
schema1:Place rdf:type owl:Class .


###  http://www.cidoc-crm.org/cidoc-crm/E39_Actor
crm:E39_Actor rdf:type owl:Class .


###  https://github.com/mod-bib/biblio-gad/ontology/ComponentPublication
gbo:ComponentPublication rdf:type owl:Class .


###  https://github.com/mod-bib/biblio-gad/ontology/PeriodicalIssue
gbo:PeriodicalIssue rdf:type owl:Class .


###  https://github.com/mod-bib/biblio-gad/ontology/Publication
gbo:Publication rdf:type owl:Class ;
                rdfs:subClassOf lrmoo:F3_Manifestation .


###  https://github.com/mod-bib/biblio-gad/ontology/PublicationComponent
gbo:PublicationComponent rdf:type owl:Class .


###  https://github.com/mod-bib/biblio-gad/ontology/PublishingHouse
gbo:PublishingHouse rdf:type owl:Class .


